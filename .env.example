# Never commit real credentials. Copy this file to .env and fill in values.

# Binance Prediction Trading API
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_WALLET_ADDRESS=
BINANCE_WALLET_ID=

# Live trading is deliberately opt-in.
LIVE_TRADING=false

# Strategy
BUY_USDT=2.00
ENTRY_MAX_PRICE=0.02
EXIT_MIN_PRICE=0.50
# Live safety default: never expose more than one $2 position at a time.
MAX_OPEN_POSITIONS=1
MAX_ORDERS_PER_MARKET=1
MARKET_POLL_SECONDS=10
ORDER_POLL_SECONDS=30
ORDER_STALE_SECONDS=86400
# Diagnostic default: start with one market. Set to 0 for all discovered markets.
MAX_MARKETS_PER_CONNECTION=1
# `all` is a one-position live test scope. `football` retains keyword filtering.
MARKET_SCOPE=all
FOOTBALL_KEYWORDS=football,soccer,premier league,champions league,la liga,bundesliga,serie a,ligue 1,mls,uefa,fifa

# Binance endpoints
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://api.binance.com/sapi/wss
# rest: use Binance's signed REST bid/ask snapshots for entries and exits.
# aggregated: continuous active-market updates. dynamic: selected market IDs.
ORDERBOOK_TOPIC_MODE=rest
# Binance requires a WebSocket PING within 60 seconds. Keep this below 30.
WS_PING_SECONDS=25
WS_RECV_TIMEOUT_SECONDS=5
BINANCE_MARKETS_URL=https://www.binance.com/bapi/defi/v1/public/wallet-direct/prediction/web/market/event/list
# Binance's web endpoint is POST-based. Override this if the request body changes.
BINANCE_MARKETS_BODY_JSON={}

# Operational safety
ENTRY_SLIPPAGE_BPS=50
EXIT_SLIPPAGE_BPS=50
FEE_RATE_BPS=200
ACCOUNT_TYPE=SPOT
FUNDING_SOURCE=MPC
LOG_LEVEL=INFO

# Optional free mobile notifications through ntfy (leave blank to disable).
# Use a long, private topic name; install the ntfy app and subscribe to it.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
